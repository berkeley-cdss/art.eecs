<%= form_with(model: user) do |form| %>
  <%= render ErrorMessagesComponent.new(record: user) %>

  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :is_admin, style: "display: block" %>
    <%= form.check_box :is_admin %>
  </div>

  <div>
    <%= form.label :is_moderator, style: "display: block" %>
    <%= form.check_box :is_moderator %>
  </div>

  <div>
    <%= form.label :is_published, style: "display: block" %>
    <%= form.check_box :is_published %>
  </div>

  <div>
    <%= form.label :bio, style: "display: block" %>
    <%= form.rich_text_area :bio %>
  </div>

  <div>
    <%= form.label :url, style: "display: block" %>
    <%= form.text_field :url %>
  </div>

  <div>
    <%= form.label :profile_image, style: "display: block" %>
    <%= form.file_field :profile_image %>
  </div>

  <div>
    <%= form.label :image_url, style: "display: block" %>
    <%= form.text_field :image_url %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
