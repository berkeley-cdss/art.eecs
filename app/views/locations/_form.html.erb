<%= form_with(model: location) do |form| %>
  <%= render ErrorMessagesComponent.new(record: location) %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :building_name, style: "display: block" %>
    <%= form.text_field :building_name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
